# Copy this file to `.env` and fill in the values.
# Never commit `.env` (it is gitignored).

# --------------------
# Ports (dev)
# --------------------
BACKEND_PORT=5000
GATEWAY_PORT=3001
FRONTEND_PORT=5173

# --------------------
# Backend (Flask)
# --------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional auth (recommended if exposing beyond localhost)
GATEWAY_TOKEN=
BACKEND_API_TOKEN=

# Optional overrides
# DB_PATH=backend/data/agent.db
# DEFAULT_TIMEZONE=Asia/Calcutta
# QUIET_HOURS_START=2
# QUIET_HOURS_END=6
# REPLY_ONLY_MODE=true
# MAX_OUTGOING_PER_HOUR_TOTAL=50
# MAX_OUTGOING_PER_HOUR_PER_RECIPIENT=30
# MEMORY_LIMIT=5
# PENDING_TTL_SECONDS=600

# Demo chat shown in the UI (no WhatsApp send)
DEMO_CHAT_ID=demo
DEMO_CHAT_NAME=Demo Chat

# --------------------
# Gateway (whatsapp-web.js)
# --------------------
# BACKEND_WEBHOOK_URL is set automatically by start scripts based on BACKEND_PORT.
# BACKEND_WEBHOOK_URL=http://127.0.0.1:5000/webhook
WWEBJS_CLIENT_ID=main
WWEBJS_AUTH_PATH=.wwebjs_auth
PUPPETEER_HEADLESS=true
# PUPPETEER_EXECUTABLE_PATH=

MIN_DELAY_SAME_RECIPIENT_MS=3000
RANDOM_SEND_DELAY_MIN_MS=2000
RANDOM_SEND_DELAY_MAX_MS=8000

# --------------------
# Frontend (Vite)
# --------------------
VITE_API_BASE_URL=http://127.0.0.1:5000
