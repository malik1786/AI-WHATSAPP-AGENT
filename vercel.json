{
  "version": 2,
  "installCommand": "cd frontend && npm install && cd ../api && uv pip install --system -r requirements.txt",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "DB_PATH": "/tmp/agent.db",
    "CLOUD_API_ACCESS_TOKEN": "",
    "CLOUD_API_PHONE_NUMBER_ID": "",
    "CLOUD_API_VERIFY_TOKEN": "whatsapp_agent_verify",
    "CLOUD_API_APP_SECRET": ""
  }
}
